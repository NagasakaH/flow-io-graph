{
  // 注文まわりの業務フロー。steps の並べ順がそのままフローの順序になる。
  "schemaVersion": 1,
  "flows": [
    {
      "id": "order-intake",
      "name": "注文受付フロー",
      "owner": "orders-team",
      "description": "受注から決済・通知まで",
      "steps": [
        {
          "id": "receive",
          "name": "注文受信",
          "reads": ["table/order_drafts"],
          "writes": ["table/orders"],
          "invokes": ["http/payment-service/charge"],
          "docs": "runbook: 注文受付 (Notion)"
        },
        {
          "id": "gate-result",
          "name": "決済結果",
          "kind": "gateway",
          "description": "charge API のレスポンスで分岐",
          "branches": [
            { "to": "charge", "label": "成功" },
            { "to": "retry-gate", "label": "失敗" }
          ]
        },
        {
          "id": "retry-gate",
          "name": "再試行判定",
          "kind": "gateway",
          "description": "3 回目までは受注からやり直し、超えたら打ち切り",
          "branches": [
            { "to": "receive", "label": "3回目まで再実行" },
            { "to": "notify", "label": "打ち切り（失敗通知）" }
          ]
        },
        {
          "id": "charge",
          "name": "決済確定",
          "description": "決済済みレコード（境界の向こうで payments に書かれる）を読んでイベント化する",
          "reads": ["table/payments"],
          "writes": ["queue/order-events"]
        },
        {
          "id": "notify",
          "name": "購入者通知",
          "reads": ["queue/order-events"],
          "writes": ["table/notifications"]
        }
      ]
    },
    {
      // 日次バッチは注文の成否と無関係な別系統。別フローにして
      // 「購入者通知 → 日次レポート」という誤った進行縁を作らせない
      "id": "daily-report",
      "name": "日次レポート",
      "owner": "analytics-team",
      "description": "毎晩 orders を集計して daily.csv と analytics-bucket に配る別系統",
      "steps": [
        {
          "id": "daily-report",
          "name": "日次レポート",
          "reads": ["table/orders"],
          "writes": ["file/reports/daily.csv", "s3/analytics-bucket/reports"]
        }
      ]
    }
  ]
}
